type Author {
  idA: ID
  name: String
  age: Int
  nationality: String
  books: [Book]
}

type Book {
  idBook: ID
  title: String
  publicationYear: Int
  language: String
  nbPages: Int
  author: Author
  category: Category
}

type Category {
  idC: ID
  categoryName: String
  parentCategory: Category
  subCategories: [Category]
}

type PageInfo {
  totalPages: Int
  totalElements: Int
}

type BookPage {
  content: [Book]
  pageInfo: PageInfo
}

type Query{
  listBooks: [Book]
  booksByAuthor(authorId: ID!): [Book]
}

type Mutation {
  addBook(
    title: String!,
    publicationYear: Int!,
    language: String!,
    nbPages: Int!,
    authorId: ID!,
    categoryId: ID!
  ): Book

  deleteAuthor(authorId: ID!): Boolean
}
